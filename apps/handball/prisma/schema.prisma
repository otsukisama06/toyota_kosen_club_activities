generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 部員の役割です。管理画面の表示や入力者区分に使います。
enum Role {
  PLAYER
  MANAGER
  COACH
  ADMIN
}

/// 出席の状態です。カレンダー集計に使います。
enum AttendanceStatus {
  ATTEND
  ABSENT
  LATE
  EARLY_LEAVE
  UNKNOWN
}

/// 共有リンクの種類です。
/// メール認証コードの用途です。
enum AuthChallengePurpose {
  LOGIN
  REGISTER
  PASSWORD_RESET
}

enum InputType {
  ATTENDANCE
  WEIGHT
}

/// 出席イベントの種別です。
enum AttendanceEventType {
  PRACTICE
  MATCH
}

/// 試合の時間帯区分です。
enum MatchPeriod {
  FIRST_HALF
  SECOND_HALF
}

/// 部員、マネージャー、コーチの基本情報です。
model Member {
  id                  String             @id @default(cuid())
  name                String
  nickname            String?            @unique
  email               String?            @unique
  passwordHash        String?
  passwordUpdatedAt   DateTime?
  sessionVersion      Int                @default(0)
  failedLoginCount    Int                @default(0)
  loginLockedUntil    DateTime?
  grade               String?
  yearlyGoal          String?
  monthlyGoal         String?
  canAccessAdmin      Boolean            @default(false)
  role                Role               @default(PLAYER)
  attendanceRateStartAt DateTime         @default(now())
   lastActivityAt      DateTime?
  createdAt           DateTime           @default(now())
  attendances         AttendanceRecord[]
  authChallenges      AuthChallenge[]
  emailBroadcasts     EmailBroadcast[]
  weights             WeightRecord[]
  tokens              InputToken[]
  createdPracticeMenus PracticeMenu[]    @relation("CreatedPracticeMenus")
  createdTimerPresets TimerPreset[]       @relation("CreatedTimerPresets")
  playerScores        PlayerMatchScore[]
  playerMatchPeriodStats PlayerMatchPeriodStat[]
  releaseNotes        ReleaseNote[]      @relation("ReleasesCreatedBy")
  announcements       AdminAnnouncement[] @relation("AnnouncementsCreatedBy")
  feedbacks           Feedback[]
  matchFeedbacks      MatchFeedback[]
  kyudoNotes    KyudoNote[]
  clubTasksCreated    ClubTask[]         @relation("ClubTasksCreatedBy")
  scoreSheets         KyudoScoreSheet[] @relation("ScoreSheetsByMember")
}

/// 毎朝 admin に送るラズパイ状態レポートの送信履歴です。
model DailyAdminStatusReport {
  id             String   @id @default(cuid())
  reportDateKey  String   @unique
  statusText     String
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([sentAt])
}

/// 出席確認したいイベント本体です。
model AttendanceEvent {
  id            String              @id @default(cuid())
  eventType     AttendanceEventType  @default(PRACTICE)
  title         String
  scheduledAt   DateTime
  endAt         DateTime?
  matchOpponent String?
  matchDetail   String?
  note          String?
  reminderSentAt DateTime?
  createdAt     DateTime            @default(now())
  records       AttendanceRecord[]
  tokens        InputToken[]
  matches       MatchRecord[]
  matchFeedbacks MatchFeedback[]
  draft         MatchScoreDraft?
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  eventId    String
  memberId   String
  status     AttendanceStatus @default(UNKNOWN)
  comment    String?
  submittedAt DateTime        @default(now())
  event      AttendanceEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

/// 体重履歴です。
model WeightRecord {
  id          String   @id @default(cuid())
  memberId    String
  weightKg    Float
  recordedOn  DateTime @default(now())
  note        String?
  submittedAt DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// 試合のスコア記録です。
model MatchRecord {
  id           String             @id @default(cuid())
  attendanceEventId String?
  opponent     String
  matchDate    DateTime
  ourScore     Int
  theirScore   Int
  note         String?
  createdAt    DateTime           @default(now())
  attendanceEvent AttendanceEvent? @relation(fields: [attendanceEventId], references: [id], onDelete: SetNull)
  playerScores PlayerMatchScore[]
  periodScores MatchPeriodScore[]
  periodPlayerStats PlayerMatchPeriodStat[]
   incidents        MatchPeriodIncident[]
}

/// 練習内容の共有用データです。
model PracticeMenu {
  id               String   @id @default(cuid())
  title            String
  practiceDate     DateTime
  menuText         String
  detail           String?
  createdByMemberId String?
  createdAt        DateTime @default(now())
  createdBy        Member?  @relation("CreatedPracticeMenus", fields: [createdByMemberId], references: [id], onDelete: SetNull)
}

/// 部活タスクの共有用データです。
model ClubTask {
  id                   String   @id @default(cuid())
  title                String
  deadlineOn           DateTime
  isCompleted          Boolean  @default(false)
  completedAt          DateTime?
  notificationDaysBefore Int    @default(3)
  notifiedAt           DateTime?
  createdByMemberId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            Member?  @relation("ClubTasksCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  @@index([isCompleted, deadlineOn])
  @@index([deadlineOn, notifiedAt])
}

/// タイマーのプリセットです。標準プリセットとユーザー作成分を保存します。
model TimerPreset {
  id                 String   @id @default(cuid())
  name               String
  durationSeconds    Int
  setCount           Int      @default(1)
  description        String?
  isSystemPreset     Boolean  @default(false)
  createdByMemberId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          Member?  @relation("CreatedTimerPresets", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  @@index([isSystemPreset, createdByMemberId])
}

/// 部員ごとの試合得点です。
model PlayerMatchScore {
  id          String    @id @default(cuid())
  memberId    String
  matchId     String
  goals       Int       @default(0)
  shotAttempts Int      @default(0)
  isGoalkeeper Boolean  @default(false)
  note        String?
  submittedAt DateTime  @default(now())
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  match       MatchRecord @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([memberId, matchId])
}

/// 前半/後半ごとのチームスコアです。
model MatchPeriodScore {
  id         String     @id @default(cuid())
  matchId    String
  period     MatchPeriod
  ourScore   Int        @default(0)
  theirScore Int        @default(0)
  quickCount Int        @default(0)
  quickSuccessCount Int @default(0)
  leftCount  Int        @default(0)
  leftSuccessCount Int  @default(0)
  centerCount Int       @default(0)
  centerSuccessCount Int @default(0)
  pivotCount Int        @default(0)
  pivotSuccessCount Int @default(0)
  reboundCount Int      @default(0)
  reboundSuccessCount Int @default(0)
  sevenMeterCount Int   @default(0)
  sevenMeterSuccessCount Int @default(0)
  savedAt    DateTime   @default(now())
  match      MatchRecord @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, period])
}

/// 前半/後半ごとの選手スタッツです。
model PlayerMatchPeriodStat {
  id          String     @id @default(cuid())
  matchId     String
  memberId    String
  period      MatchPeriod
  shotAttempts Int       @default(0)
  goals       Int        @default(0)
  quickAttempts Int      @default(0)
  quickGoals Int         @default(0)
  leftAttempts Int       @default(0)
  leftGoals Int          @default(0)
  centerAttempts Int     @default(0)
  centerGoals Int        @default(0)
  pivotAttempts Int      @default(0)
  pivotGoals Int         @default(0)
  reboundAttempts Int    @default(0)
  reboundGoals Int       @default(0)
  sevenMeterAttempts Int @default(0)
  sevenMeterGoals Int    @default(0)
  isGoalkeeper Boolean   @default(false)
  savedAt     DateTime   @default(now())
  match       MatchRecord @relation(fields: [matchId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([matchId, memberId, period])
  @@index([matchId, period])
}

/// 前半/後半ごとの退場・警告記録です。
model MatchPeriodIncident {
  id          String     @id @default(cuid())
  matchId     String
  period      MatchPeriod
  team        String     // "OUR" or "OPPONENT"
  kind        String     // "TWO_MIN" or "YELLOW"
  minute      Int
  playerName  String?
  savedAt     DateTime   @default(now())
  match       MatchRecord @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, period])
}

/// 試合スコア入力のドラフト自動保存です。
model MatchScoreDraft {
  id                  String         @id @default(cuid())
  attendanceEventId   String         @unique
  draftJson           Json
  updatedAt           DateTime       @default(now()) @updatedAt
  attendanceEvent     AttendanceEvent @relation(fields: [attendanceEventId], references: [id], onDelete: Cascade)
}

/// 部員へ配布する入力用の共有リンクです。
model InputToken {
  id         String    @id @default(cuid())
  token      String    @unique
  type       InputType
  memberId   String
  eventId    String?
  expiresAt  DateTime
  isActive   Boolean   @default(true)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event      AttendanceEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

/// リリースノートです。管理者のみが作成できます。
model ReleaseNote {
  id          String   @id @default(cuid())
  version     String   @unique
  title       String
  content     String
  createdByMemberId String
  createdAt  DateTime @default(now())
  createdBy  Member   @relation("ReleasesCreatedBy", fields: [createdByMemberId], references: [id], onDelete: Cascade)
}

/// 部員がアプリ改善のために送るフィードバックです。
model Feedback {
  id                 String   @id @default(cuid())
  memberId           String
  memberNameSnapshot String
  content            String
  createdAt          DateTime @default(now())
  member             Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// 試合の振り返りです。各部員が試合ごとに1つ記録できます。
model MatchFeedback {
  id          String   @id @default(cuid())
  attendanceEventId String
  memberId    String
  feedback    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  event       AttendanceEvent @relation(fields: [attendanceEventId], references: [id], onDelete: Cascade)
  member      Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([attendanceEventId, memberId])
  @@index([attendanceEventId])
}

/// 弓道ノートです。部員ごとに日付単位で複数件保存できます。
model KyudoNote {
  id          String   @id @default(cuid())
  memberId    String
  noteDateKey String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, noteDateKey])
  @@index([memberId, createdAt])
}

/// 弓道スコアシート（複数作成可能）。
model KyudoScoreSheet {
  id            String              @id @default(cuid())
  memberId      String
  opponent      String
  matchDate     DateTime
  comment       String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  member        Member              @relation("ScoreSheetsByMember", fields: [memberId], references: [id], onDelete: Cascade)
  entries       MatchScoreEntry[]

  @@index([memberId, matchDate])
}

/// 各セットのスコア記録です。
model MatchScoreEntry {
  id              String      @id @default(cuid())
  scoreSheetId    String
  setNumber       Int         // 1-5
  ourScore        Int
  theirScore      Int
  winner          String?     // "OUR" or "OPPONENT"
  comment         String?
  createdAt       DateTime    @default(now())
  scoreSheet      KyudoScoreSheet @relation(fields: [scoreSheetId], references: [id], onDelete: Cascade)

  @@unique([scoreSheetId, setNumber])
  @@index([scoreSheetId])
}

/// 管理者が期間指定で表示する通達メッセージです。
model AdminAnnouncement {
  id                String   @id @default(cuid())
  message           String
  startsAt          DateTime
  endsAt            DateTime
  createdByMemberId String
  createdAt         DateTime @default(now())
  createdBy         Member   @relation("AnnouncementsCreatedBy", fields: [createdByMemberId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
  @@index([createdAt])
}

/// メールで送る6桁の認証コード（ログイン二段階認証・新規登録・パスワード再設定）です。
model AuthChallenge {
  id         String               @id @default(cuid())
  purpose    AuthChallengePurpose
  memberId   String?
  member     Member?              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  email      String
  codeHash   String
  payload    Json?
  attempts   Int                  @default(0)
  expiresAt  DateTime
  sentAt     DateTime             @default(now())
  consumedAt DateTime?
  createdAt  DateTime             @default(now())

  @@index([memberId])
  @@index([expiresAt])
}

/// スーパーアドミンが送信したメール一斉送信の履歴です。
model EmailBroadcast {
  id              String   @id @default(cuid())
  subject         String
  body            String
  targetSummary   String
  recipientCount  Int
  sentCount       Int
  failedCount     Int
  createdById     String?
  createdBy       Member?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([createdAt])
}
